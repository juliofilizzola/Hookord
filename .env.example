# Application Environment
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Channel IDs for Notifications
DISCORD_CHANNEL_PULL_REQUESTS=your_channel_id_here
DISCORD_CHANNEL_ISSUES=your_channel_id_here
DISCORD_CHANNEL_WORKFLOWS=your_channel_id_here
DISCORD_CHANNEL_REPOSITORY=your_channel_id_here

# GitHub Configuration
GITHUB_SECRET=your_github_webhook_secret_here

# Infrastructure
REDIS_URL=redis://localhost:6379

# Slack configuration
SLACK_TOKEN=slack_token
SLACK_CHANNEL_ID=your_channel_id

# Telegram configuration
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
